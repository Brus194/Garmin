# Kopiér til .env og udfyld med dine egne værdier
GARMIN_EMAIL=din@email.dk
GARMIN_PASSWORD=dit-password

# Sti til den lokale SQLite-database (default: garmin.db i projektroden)
DB_PATH=garmin.db

# Mappe hvor Garmin OAuth-tokens gemmes/genbruges
GARMIN_TOKENSTORE=~/.garminconnect

# Hvor mange dages historik der hentes ved første kørsel (backfill)
BACKFILL_DAYS=365

# Antal dage tilbage der altid re-synces (for at fange efter-redigeringer)
SYNC_OVERLAP_DAYS=3
